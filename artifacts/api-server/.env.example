# ─── Blaze API Server — env vars ─────────────────────────────────────────────
# Copy this file to .env for local development.

# PostgreSQL connection string (Neon, Supabase, Railway Postgres, etc.)
DATABASE_URL=postgresql://user:password@host:5432/blaze_booking

# Resend API key for sending email confirmations
# Get yours at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx

# Port the server listens on
PORT=5000
